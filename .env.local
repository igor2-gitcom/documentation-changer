# ============================================
# Локальная модель Qwen3 - Environment Variables
# ============================================
# Для закрытой сети без доступа к интернету

# ---- Локальная модель ----
# Модель, загруженная в Ollama или vLLM
QWEN_MODEL=qwen3:8b

# Для Ollama (не требует ключа)
# QWEN_API_KEY=ollama
# QWEN_BASE_URL=http://ollama:11434/v1

# Для vLLM (не требует ключа)
# QWEN_API_KEY=empty
# QWEN_BASE_URL=http://vllm:8000/v1

# ---- CORS ----
CORS_ORIGIN=http://localhost

# ---- vLLM параметры (опционально) ----
# MAX_MODEL_LEN=4096
# GPU_MEM_UTIL=0.9
# TP_SIZE=1
