# ============================================
# Qwen3 Document Correction - Environment Variables
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# ---- Qwen3 API Configuration ----
# API ключ DashScope (получить на https://dashscope.aliyuncs.com)
QWEN_API_KEY=sk-your-api-key-here

# Базовый URL API (по умолчанию DashScope)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Модель Qwen3
# Варианты: qwen3, qwen3-235b-a22b, qwen3-32b, qwen3-30b-a3b, 
#           qwen3-14b, qwen3-8b, qwen3-4b, qwen3-1.7b, qwen3-0.6b
QWEN_MODEL=qwen3

# ---- CORS Configuration ----
# Разрешённый источник (для frontend)
CORS_ORIGIN=http://localhost

# ---- Port Configuration ----
# Порт frontend (nginx)
FRONTEND_PORT=80

# Порт backend
BACKEND_PORT=3001
